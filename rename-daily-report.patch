From 3aab5b44c72a761e8c3e09fb31e5b9021d7496eb Mon Sep 17 00:00:00 2001
From: Ericson Ramirez <ericsonramirezm@gmail.com>
Date: Sat, 22 Aug 2026 21:31:51 +0000
Subject: [PATCH] Renombra 'Parte Diario' a 'Daily Report' en toda la interfaz
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Cambia el texto visible al usuario (título del listado, título del
detalle, botón 'Nuevo', mensajes de error) y los comentarios del código.
No se tocan nombres internos (componentes ParteDiario*, tabla
partes_diarios, ruta 'parte-diario') para no arriesgar una migracion de
datos/rutas innecesaria — solo cambia lo que el usuario ve.
---
 src/components/Layout/Layout.tsx                  | 11 +++++++----
 src/components/ParteDiario/GestorFotos.tsx        |  2 +-
 src/components/ParteDiario/ParteDiarioDetalle.tsx |  4 ++--
 src/components/ParteDiario/ParteDiarioForm.tsx    |  6 +++---
 src/components/ParteDiario/ParteDiarioList.tsx    |  4 ++--
 src/types/index.ts                                |  4 ++--
 6 files changed, 17 insertions(+), 14 deletions(-)

diff --git a/src/components/Layout/Layout.tsx b/src/components/Layout/Layout.tsx
index 4dcfb44..03023dc 100644
--- a/src/components/Layout/Layout.tsx
+++ b/src/components/Layout/Layout.tsx
@@ -84,12 +84,15 @@ export const Layout = ({ usuario, onLogout, children, activeView, onViewChange }
             />
           )}
 
-          {/* Parte Diario: módulo independiente de Documentos QR — mismo
-              login, mismo layout, datos separados (ver ARQUITECTURA.md).
-              El rol "mandante" solo ve este módulo. */}
+          {/* Daily Report (ex "Parte Diario"): módulo independiente de
+              Documentos QR — mismo login, mismo layout, datos separados
+              (ver ARQUITECTURA.md). Visible para TODOS los roles
+              autenticados a propósito, sin gating por rol: el rol
+              "mandante" solo ve este módulo, y coordinador/supervisor/apr/
+              consultor lo ven además de Documentos QR. */}
           <NavItem
             icon="📝"
-            label="Parte Diario"
+            label="Daily Report"
             active={activeView === 'parte-diario'}
             onClick={() => onViewChange('parte-diario')}
             expanded={navExpanded}

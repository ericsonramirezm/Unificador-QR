From 0eca4984a9b427ae0dce796e0cae857dd0b0b002 Mon Sep 17 00:00:00 2001
From: Ericson Ramirez <ericsonramirezm@gmail.com>
Date: Sat, 22 Aug 2026 14:29:44 +0000
Subject: [PATCH] Genera el Excel real del Parte Diario (ExcelJS sobre la
 plantilla original)

- generarExcelParteDiario.ts: escribe cada valor en su celda exacta sobre
  la plantilla DR000_12501191.xlsx (public/plantillas/), sin tocar
  formato/logos/formulas. Incluye fotos en la hoja Imagenes.
- Boton 'Descargar Excel' en el detalle del parte diario.
- Dependencia exceljs.
- add_partes_diarios.sql: documenta el ALTER de usuarios_rol_check que
  ya se aplico manualmente para habilitar el rol mandante.
---
 add_partes_diarios.sql                        |   10 +-
 package-lock.json                             | 1034 +++++++++++-
 package.json                                  |    1 +
 parte-diario-integracion.patch                | 1492 -----------------
 public/plantillas/DR000_12501191.xlsx         |  Bin 0 -> 59416 bytes
 .../ParteDiario/ParteDiarioDetalle.tsx        |   28 +-
 src/lib/generarExcelParteDiario.ts            |  167 ++
 7 files changed, 1177 insertions(+), 1555 deletions(-)
 delete mode 100644 parte-diario-integracion.patch
 create mode 100644 public/plantillas/DR000_12501191.xlsx
 create mode 100644 src/lib/generarExcelParteDiario.ts

diff --git a/add_partes_diarios.sql b/add_partes_diarios.sql
index 94a3f87..b83fd92 100644
--- a/add_partes_diarios.sql
+++ b/add_partes_diarios.sql
@@ -10,9 +10,13 @@
 -- ============================================================
 
 -- ---------- rol nuevo ----------
--- "usuarios.rol" es tipo text (no enum de Postgres), así que no hace
--- falta ALTER TYPE: basta con permitirlo en las políticas de abajo y
--- en el enum de TypeScript (src/types/index.ts).
+-- "usuarios.rol" es tipo text (no enum de Postgres) pero tiene un check
+-- constraint que solo permitía los roles previos — hay que ampliarlo,
+-- además de permitirlo en las políticas de abajo y en el enum de
+-- TypeScript (src/types/index.ts).
+alter table public.usuarios drop constraint if exists usuarios_rol_check;
+alter table public.usuarios add constraint usuarios_rol_check
+  check (rol in ('coordinador', 'apr', 'supervisor', 'consultor', 'mandante'));
 
 -- ---------- tabla principal ----------
 create table if not exists public.partes_diarios (
